{
  "name": "openai-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives an agent a local subagent: offload low-complexity work to a small model on Ollama (or any OpenAI-compatible endpoint) without burning frontier tokens",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "configure": "node scripts/configure.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "diff": "^8.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.0"
  }
}
